# --- Required credentials (backend only; never exposed to the browser) ---
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Tavily search (free tier available): https://app.tavily.com
TAVILY_API_KEY=

# --- Model and storage ---
GEMINI_MODEL=gemini-3.5-flash
DATABASE_URL=sqlite:///./research.db

# --- Research limits ---
MAX_SUBQUESTIONS=4
MAX_SOURCES_PER_SUBQUESTION=5
MAX_REVISION_CYCLES=2
REQUEST_TIMEOUT_SECONDS=20
# Optional tuning (defaults shown)
# LLM_TIMEOUT_SECONDS=90
# MAX_RESEARCH_SECONDS=900
# MAX_CONCURRENT_RESEARCH=2
# MAX_CONCURRENT_SEARCHES=3
# MAX_CONCURRENT_FETCHES=5
# CREATE_RATE_LIMIT_PER_MINUTE=10

# --- Web ---
# Comma-separated list of origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000
# Browser-facing backend URL used when building the frontend image (docker compose).
# PUBLIC_API_BASE_URL=http://localhost:8000
